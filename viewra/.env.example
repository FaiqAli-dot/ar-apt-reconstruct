# Runtime
NODE_ENV=development

# Database
DATABASE_URL=mongodb://localhost:27017/viewra
DATABASE_NAME=viewra

# Auth
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Object storage (S3-compatible: MinIO, Cloudflare R2, AWS S3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=viewra
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/viewra

# API
API_URL=http://localhost:3001
API_HOST=0.0.0.0
API_PORT=3001
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW_MS=60000
LOG_LEVEL=info

# Worker
WORKER_POLL_INTERVAL_MS=2000
WORKER_CONCURRENCY=2
WORKER_MAX_RETRIES=5

# Frontend (shared + Vite apps)
PUBLIC_VIEWER_URL=http://localhost:5174
VITE_API_URL=http://localhost:3001
VITE_PUBLIC_VIEWER_URL=http://localhost:5174
VITE_S3_PUBLIC_URL=http://localhost:9000/viewra

# Seed (used by `pnpm seed`)
SEED_ADMIN_EMAIL=admin@viewra.local
SEED_ADMIN_PASSWORD=ViewraAdmin123!
SEED_OPERATOR_EMAIL=operator@viewra.local
SEED_OPERATOR_PASSWORD=ViewraOperator123!
